{
  "name": "one-brain",
  "version": "1.2.0",
  "description": "A local desktop app for saving and searching AI memories.",
  "author": "One Brain",
  "desktopName": "one-brain",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "bench": "node scripts/bench.js",
    "build:extension": "node scripts/build-extension.js",
    "pack": "npm run build && npm run build:extension && electron-builder --dir",
    "dist": "npm run build && npm run build:extension && electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3",
    "vite": "^8.3.3",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.onebrain.desktop",
    "productName": "One Brain",
    "directories": { "output": "release" },
    "files": ["!test/**", "!extension/**", "!scripts/**", "!README.md", "!AGENTS.md"],
    "extraResources": [
      { "from": "scripts/mcp-stdio.js", "to": "one-brain/scripts/mcp-stdio.js" },
      { "from": "scripts/mcp-stdio-port.js", "to": "one-brain/scripts/mcp-stdio-port.js" },
      { "from": "extension/dist", "to": "one-brain/extension" }
    ],
    "electronFuses": {
      "runAsNode": true,
      "enableNodeCliInspectArguments": false,
      "enableNodeOptionsEnvironmentVariable": false
    },
    "linux": { "target": ["AppImage"], "category": "Utility", "syncDesktopName": true },
    "mac": { "target": ["dmg", "zip"] },
    "win": { "target": ["nsis"] }
  }
}
